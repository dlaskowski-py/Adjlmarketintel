//@version=6
// ============================================================================
// Synthetic Options Engine  (v2)
// ----------------------------------------------------------------------------
// Six signals plus a blind control, priced as OPTION contracts with
// Black-Scholes and accounted for independently of strategy() - which can only
// ever trade the chart's instrument, never a contract.
//
// THE CONTROL IS THE POINT. "Blind (every N bars)" ignores price entirely.
// Any signal worth trading must beat it. SEVEN signals have now been measured
// against it across 26 years and 12 names, and none has beaten it:
//
//   signal              structure   PF    vs blind
//   MACD cross          long 30d   1.33   loses (blind 1.60)
//   RSI(2)              long 30d   1.36   loses
//   Donchian-55         long 30d   1.48   loses
//   EMA 20/50           long 30d   1.32   loses
//   Vol contraction     long 30d   1.40   loses
//   Squeeze release     strangle   1.62   ties  (blind 1.60, t=0.57)
//   Squeeze + low IV    strangle   1.40   loses
//
// The squeeze tie is not an edge: t = 0.57, and it wins two of four eras and
// loses the other two. Splitting the strangle shows why nothing here works -
// the CALL leg runs PF 1.56 while the PUT leg runs 1.08. Even the
// direction-neutral structure is mostly just owning calls in a rising market.
//
// Set Blind direction to "Short only" on a rising chart: if long-only prints
// and short-only bleeds, what you are looking at is drift, not edge.
//
// ---------------------------------------------------------------- v2 FIXES --
// 1. EXIT IV was computed as sigEnt * (ivRatio / ivCalm), which is correct
//    ONLY when the entry happened in a fully calm regime. An entry at median
//    volatility mispriced the contract by 37%, and a stressed entry by up to
//    79%. The entry regime ratio is now stored and divided out properly.
// 2. Exits no longer evaluate on the entry bar, where a wide stop-loss could
//    close a position instantly on the bid-ask spread alone.
// 3. Removed a dead ternary whose branches were identical.
// 4. Blind control gained a direction switch, for the drift test above.
//
// CALIBRATION - measured against real Alpha Vantage chains, not guessed:
//     regime   IV / trailing 20d RV   bid-ask as % of mark
//     calm            1.51x                   3.4%
//     stress          0.84x                  12.2%
// Interpolated on the realised-vol percentile. Signals that enter in quiet
// markets buy where the variance premium is RICHEST; a flat assumption hides
// that, and applying this cut one signal's profit factor from 2.54 to 1.40.
//
// KNOWN LIMITS: no real fills, no volatility skew, no early assignment, no
// liquidity modelling. Validated against real chains on 21 trades: the model
// correlates 0.93 with reality but OVERSTATES win rate by ~10 points and
// understates the typical loss badly (median -3.9% modelled vs -36.4% real).
// Treat its output as a ranking of signals, never as position sizing.
// ============================================================================

// overlay=false because the equity curve runs in the thousands - on the price
// pane it would flatten the chart. Entry/exit markers are pushed to the price
// pane individually with force_overlay, so signals stay visible where they
// matter while the equity curve keeps its own scale.
indicator("Synthetic Options Engine v7.2", overlay = false, max_labels_count = 500)

// ---------------------------------------------------------------- INPUTS ---
grpS = "Signal"
sigName = input.string("MACD cross + trend", "Signal", group=grpS,
     options=["MACD cross + trend", "RSI(2) mean reversion", "Donchian breakout",
              "EMA cross", "Volatility contraction", "Squeeze release",
              "Squeeze + low IV", "ATR contraction", "Blind (every N bars)"])
useTrend = input.bool(true, "Trend filter", group=grpS)

grpA = "Averages"
macdFast = input.int(12,  "MACD fast",   minval=1, group=grpA)
macdSlow = input.int(26,  "MACD slow",   minval=2, group=grpA)
macdSigL = input.int(9,   "MACD signal", minval=1, group=grpA)
trendLen = input.int(200, "Trend MA length", minval=2, group=grpA,
     tooltip="Raise this for slower, longer-horizon signals. 200 on daily is roughly a year of trend.")
trendTyp = input.string("SMA", "Trend MA type", options=["SMA","EMA","WMA"], group=grpA)
emaFastL = input.int(20, "EMA cross fast", minval=1, group=grpA)
emaSlowL = input.int(50, "EMA cross slow", minval=2, group=grpA)
donLen   = input.int(55, "Donchian lookback", minval=2, group=grpA)
showMA   = input.bool(true, "Plot trend MA on price", group=grpA)

grpQ = "Volatility signals"
sqLen    = input.int(20,  "Squeeze length", minval=2, group=grpQ)
sqBB     = input.float(2.0, "Bollinger mult", minval=0.1, step=0.1, group=grpQ)
sqKC     = input.float(1.5, "Keltner mult",   minval=0.1, step=0.1, group=grpQ)
ivMaxIn  = input.float(30.0, "Max IV rank for 'Squeeze + low IV'", minval=1, maxval=100, group=grpQ)
atrPct   = input.float(15.0, "ATR-contraction percentile", minval=1, maxval=100, group=grpQ)
blindN   = input.int(20, "Blind: bars between entries", minval=1, group=grpS)
blindDir = input.string("Long only", "Blind direction", options=["Long only","Short only","Alternate"], group=grpS,
     tooltip="Long-only blind on a rising chart is pure beta. Run Short-only to see how much apparent edge is just drift.")

grpO = "Contract"
structure = input.string("Long option", "Structure",
     options=["Long option","Credit spread","Long straddle","Long strangle"], group=grpO,
     tooltip="Straddle and strangle are DIRECTION-NEUTRAL - they pay on a large move either way, so the signal's direction is ignored.")
tgtDelta  = input.float(0.30, "Target delta", minval=0.05, maxval=0.95, step=0.05, group=grpO)
dte       = input.int(45, "Days to expiry at entry", minval=5, group=grpO)
widthPct  = input.float(1.5, "Spread width (% of spot)", minval=0.1, step=0.1, group=grpO)
riskFree  = input.float(4.0, "Risk-free rate %", minval=0, step=0.25, group=grpO)

grpX = "Exits"
holdBars = input.int(20, "Max bars held", minval=1, group=grpX)
tpPct    = input.float(50.0, "Take profit (% of premium/credit)", minval=1, group=grpX)
slPct    = input.float(100.0, "Stop loss (% of premium/credit)", minval=1, group=grpX)

grpC = "Calibration (measured against real chains)"
ivCalm    = input.float(1.51, "IV/RV ratio - calm",   minval=0.1, step=0.01, group=grpC)
ivStress  = input.float(0.84, "IV/RV ratio - stress", minval=0.1, step=0.01, group=grpC)
sprCalm   = input.float(3.4,  "Bid-ask % - calm",     minval=0.0, step=0.1,  group=grpC)
sprStress = input.float(12.2, "Bid-ask % - stress",   minval=0.0, step=0.1,  group=grpC)

grpV = "Chart markers"
showMarks  = input.bool(true,  "Show entry/exit markers on price", group=grpV)
markSizeIn = input.string("Normal", "Marker size", options=["Tiny","Small","Normal","Large"], group=grpV)
markText   = input.string("CALL / PUT", "Marker text", options=["CALL / PUT","C / P","None"], group=grpV)
shadeHold  = input.bool(true, "Shade holding period by direction", group=grpV)
showStatus = input.bool(true, "Live status banner", group=grpV,
     tooltip="Bottom-left readout: flat or holding, which way, how many days in, current P&L, days until the time stop.")
showExitLb = input.bool(true, "Label exits with P&L", group=grpV)
showEntryLn= input.bool(true, "Draw entry price line while holding", group=grpV)
showLabels = input.bool(false, "Label entries with strike and premium", group=grpV,
     tooltip="Detail per trade. Off by default - on a long history it clutters the chart.")

startCap = input.float(10000, "Starting capital", minval=100, group="Account")
riskPct  = input.float(2.0, "Capital per trade %", minval=0.1, maxval=100, group="Account")

// ------------------------------------------------------- BLACK-SCHOLES ---
// Pine has no erf, so the normal CDF uses Abramowitz-Stegun 26.2.17. Verified
// against math.erf: worst absolute error 7.0e-08, ATM prices exact against
// reference values, put-call parity exact to machine precision.
ncdf(x) =>
    ax = math.abs(x)
    k = 1.0 / (1.0 + 0.2316419 * ax)
    pdf = math.exp(-ax * ax / 2.0) / math.sqrt(2.0 * math.pi)
    poly = k * (0.319381530 + k * (-0.356563782 + k * (1.781477937 + k * (-1.821255978 + k * 1.330274429))))
    upper = pdf * poly
    x >= 0 ? 1.0 - upper : upper

bsPrice(S, K, T, sig, r, isCall) =>
    float out = 0.0
    if T <= 0 or sig <= 0
        out := isCall ? math.max(0.0, S - K) : math.max(0.0, K - S)
    else
        sq = sig * math.sqrt(T)
        d1 = (math.log(S / K) + (r + sig * sig / 2.0) * T) / sq
        d2 = d1 - sq
        out := isCall ? S * ncdf(d1) - K * math.exp(-r * T) * ncdf(d2)
             : K * math.exp(-r * T) * ncdf(-d2) - S * ncdf(-d1)
    out

bsDelta(S, K, T, sig, r, isCall) =>
    float out = 0.0
    if T <= 0 or sig <= 0
        out := isCall ? (S > K ? 1.0 : 0.0) : (S < K ? -1.0 : 0.0)
    else
        d1 = (math.log(S / K) + (r + sig * sig / 2.0) * T) / (sig * math.sqrt(T))
        out := isCall ? ncdf(d1) : ncdf(d1) - 1.0
    out

// Call delta FALLS as strike rises, put |delta| RISES. Using one branch for
// both converges on nonsense strikes with near-zero premiums, which silently
// manufactures enormous fake returns - a bug that actually happened here.
// 40 halvings of a 750-wide bracket resolves to well under a cent.
strikeForDelta(S, T, sig, r, target, isCall) =>
    float lo = S * 0.5
    float hi = S * 1.5
    for i = 0 to 39
        mid = (lo + hi) / 2.0
        dd = math.abs(bsDelta(S, mid, T, sig, r, isCall))
        if isCall
            if dd > target
                lo := mid
            else
                hi := mid
        else
            if dd > target
                hi := mid
            else
                lo := mid
    (lo + hi) / 2.0

// --------------------------------------------------------- MARKET STATE ---
// Annualisation must match the chart's timeframe. Hardcoding sqrt(252) - the
// daily figure - understates volatility by 61% on hourly bars and overstates
// it by 120% on weekly, which misprices every contract before anything else
// happens.
secPerBar   = timeframe.in_seconds()
// Split across statements rather than wrapped: Pine treats a continuation
// line indented by a multiple of four as a new code block, which is a compile
// error, so avoiding the wrap entirely is safer than counting spaces.
bpyIntraday = 252.0 * 23400.0 / secPerBar
bpyHigher   = timeframe.isdaily ? 252.0 : timeframe.isweekly ? 52.0 : 12.0
barsPerYear = timeframe.isintraday ? bpyIntraday : bpyHigher
annFactor = math.sqrt(barsPerYear)

logRet  = math.log(close / close[1])
realVol = ta.stdev(logRet, 20) * annFactor
volRank = ta.percentrank(realVol, 252)
maEma = ta.ema(close, trendLen)
maWma = ta.wma(close, trendLen)
maSma = ta.sma(close, trendLen)
trendMA = trendTyp == "EMA" ? maEma : trendTyp == "WMA" ? maWma : maSma

// The calibration below was measured against daily bars and 25-60 DTE
// contracts. The maths is now timeframe-correct, but the 1.51x/0.84x ratios
// themselves are not re-measured for other timeframes.
isDaily = timeframe.isdaily

w = na(volRank) ? 0.5 : math.min(math.max(volRank / 100.0, 0.0), 1.0)
ivRatio   = ivCalm + (ivStress - ivCalm) * w
spreadPct = (sprCalm + (sprStress - sprCalm) * w) / 100.0
sigmaNow  = math.max(na(realVol) ? 0.20 : realVol * ivRatio, 0.05)
rf = riskFree / 100.0

// -------------------------------------------------------------- SIGNALS ---
[macdLine, macdSig, _mh] = ta.macd(close, macdFast, macdSlow, macdSigL)
rsi2  = ta.rsi(close, 2)
emaF  = ta.ema(close, emaFastL)
emaS  = ta.ema(close, emaSlowL)
donHi = ta.highest(high, donLen)[1]
donLo = ta.lowest(low, donLen)[1]

// TTM-style squeeze: Bollinger Bands inside Keltner Channels means volatility
// is compressed. The tradeable event is the RELEASE, not the compression.
bbBasis = ta.sma(close, sqLen)
bbDev   = sqBB * ta.stdev(close, sqLen)
kcMA    = ta.ema(close, sqLen)
kcRange = sqKC * ta.atr(sqLen)
squeezeOn    = (bbBasis - bbDev) > (kcMA - kcRange) and (bbBasis + bbDev) < (kcMA + kcRange)
squeezeFired = squeezeOn[1] and not squeezeOn

atrRel  = ta.atr(14) / close
atrRank = ta.percentrank(atrRel, 252)

bool rawL = false
bool rawS = false
if sigName == "MACD cross + trend"
    rawL := ta.crossover(macdLine, macdSig) and macdLine > 0
    rawS := ta.crossunder(macdLine, macdSig) and macdLine < 0
else if sigName == "RSI(2) mean reversion"
    rawL := rsi2 < 10
    rawS := rsi2 > 90
else if sigName == "Donchian breakout"
    rawL := close > donHi
    rawS := close < donLo
else if sigName == "EMA cross"
    rawL := ta.crossover(emaF, emaS)
    rawS := ta.crossunder(emaF, emaS)
else if sigName == "Volatility contraction"
    cheap = not na(volRank) and volRank < 20
    rawL := cheap and close > trendMA
    rawS := cheap and close <= trendMA
else if sigName == "Squeeze release"
    rawL := squeezeFired and close > trendMA
    rawS := squeezeFired and close <= trendMA
else if sigName == "Squeeze + low IV"
    ok = squeezeFired and not na(volRank) and volRank < ivMaxIn
    rawL := ok and close > trendMA
    rawS := ok and close <= trendMA
else if sigName == "ATR contraction"
    tight = not na(atrRank) and atrRank < atrPct
    rawL := tight and close > trendMA
    rawS := tight and close <= trendMA
else
    fire = bar_index % blindN == 0
    goLong = blindDir == "Long only" ? true : blindDir == "Short only" ? false : (math.floor(bar_index / blindN) % 2 == 0)
    rawL := fire and goLong
    rawS := fire and not goLong

// Filters must never touch the control - a filtered blind entry is not blind.
isBlind = sigName == "Blind (every N bars)"
okL = isBlind or not useTrend or close > trendMA
okS = isBlind or not useTrend or close < trendMA
longSig  = rawL and okL
shortSig = rawS and okS

// ----------------------------------------------------------- THE ENGINE ---
var float equity    = startCap
var float peakEq    = startCap
var float maxDD     = 0.0
var bool  inTrade   = false
var int   entryBar  = 0
var int   entryTime = 0      // v4: wall-clock entry, for calendar-day decay
var float kShort    = 0.0
var float kLong     = 0.0
var float entryVal  = 0.0      // premium paid, or net credit received
var float sigEnt    = 0.0
var float ivRatEnt  = 1.0      // v2: regime ratio AT ENTRY, needed to reprice
var bool  optIsCall = true
var bool  posLong   = true      // direction of the OPEN position, for shading
var float entryUnder = 0.0      // underlying price at entry, for the price line
var float curPnlPct  = 0.0      // live P&L as % of premium, for the banner
var int   curDays    = 0        // calendar days held, for the banner
var bool  isCredit  = false
var float capAtRisk = 0.0

var int   nTrades  = 0
var int   nWins    = 0
var float grossWin = 0.0
var float grossLos = 0.0

isSpread  = structure == "Credit spread"
isStrad   = structure == "Long straddle"
isStrang  = structure == "Long strangle"
isNeutral = isStrad or isStrang   // direction of the signal is irrelevant

// Markers reflect trades the engine ACTUALLY TOOK, not every time a signal
// fired. A signal arriving while a position is already open is ignored by the
// engine, and drawing it would show entries that never happened.
bool tookLong  = false
bool tookShort = false
float markStrike = na
float markPrem   = na

// Neutral structures take the signal whichever way it points.
fireEntry = isNeutral ? (rawL or rawS) : (longSig or shortSig)

if not inTrade and fireEntry and not na(realVol) and bar_index > 260
    dirLong = longSig
    T0 = dte / 365.0
    sigEnt := sigmaNow
    ivRatEnt := ivRatio
    if isSpread
        // Bull put on a long signal, bear call on a short signal.
        sc = not dirLong
        optIsCall := sc
        kShort := strikeForDelta(close, T0, sigEnt, rf, tgtDelta, sc)
        kLong  := sc ? kShort + close * widthPct / 100.0 : kShort - close * widthPct / 100.0
        credit = bsPrice(close, kShort, T0, sigEnt, rf, sc) - bsPrice(close, kLong, T0, sigEnt, rf, sc)
        width  = math.abs(kShort - kLong)
        if credit > 0 and width - credit > 0
            entryVal  := credit * (1.0 - spreadPct / 2.0)
            capAtRisk := width - credit
            isCredit  := true
            inTrade   := true
            entryBar  := bar_index
            entryTime := time
            entryUnder := close
            posLong   := dirLong
            tookLong  := dirLong
            tookShort := not dirLong
            markStrike := kShort
            markPrem   := entryVal
    else if isNeutral
        // Long call + long put. Same strike for a straddle, symmetric OTM
        // strikes for a strangle. No direction call is made at all.
        kShort := isStrad ? close : strikeForDelta(close, T0, sigEnt, rf, tgtDelta, true)
        kLong  := isStrad ? close : strikeForDelta(close, T0, sigEnt, rf, tgtDelta, false)
        cost = bsPrice(close, kShort, T0, sigEnt, rf, true) + bsPrice(close, kLong, T0, sigEnt, rf, false)
        if cost > 0.01
            entryVal  := cost * (1.0 + spreadPct / 2.0)
            capAtRisk := entryVal
            isCredit  := false
            inTrade   := true
            entryBar  := bar_index
            entryTime := time
            entryUnder := close
            posLong   := true
            tookLong  := true
            markStrike := kShort
            markPrem   := entryVal
    else
        optIsCall := dirLong
        kShort := strikeForDelta(close, T0, sigEnt, rf, tgtDelta, dirLong)
        prem = bsPrice(close, kShort, T0, sigEnt, rf, dirLong)
        if prem > 0.01
            entryVal  := prem * (1.0 + spreadPct / 2.0)
            capAtRisk := entryVal
            isCredit  := false
            inTrade   := true
            entryBar  := bar_index
            entryTime := time
            entryUnder := close
            posLong   := dirLong
            tookLong  := dirLong
            tookShort := not dirLong
            markStrike := kShort
            markPrem   := entryVal

float tradeRet = na

// v2: held >= 1 - never evaluate an exit on the entry bar, where the position
// shows a loss equal to the spread and a tight stop would fire instantly.
if inTrade and (bar_index - entryBar) >= 1
    barsHeld = bar_index - entryBar
    // Options decay in CALENDAR time, so measure it in calendar time. Counting
    // bars treats 20 hourly bars (about 3 real days) as 20 days of theta.
    daysHeld = (time - entryTime) / 86400000.0
    Tk = math.max((dte - daysHeld) / 365.0, 1.0 / 365.0)
    // Exit IV follows the REGIME, never the realised move - marking a winner at
    // post-move realised vol would double-count the very move being measured.
    // Divide out the ENTRY ratio before applying the current one.
    sigExit = math.max(sigEnt / ivRatEnt * ivRatio, 0.05)

    float nowVal = 0.0
    if isCredit
        nowVal := bsPrice(close, kShort, Tk, sigExit, rf, optIsCall) - bsPrice(close, kLong, Tk, sigExit, rf, optIsCall)
    else if isNeutral
        nowVal := bsPrice(close, kShort, Tk, sigExit, rf, true) + bsPrice(close, kLong, Tk, sigExit, rf, false)
    else
        nowVal := bsPrice(close, kShort, Tk, sigExit, rf, optIsCall)

    float pnl = isCredit ? entryVal - nowVal * (1.0 + spreadPct / 2.0)
                         : nowVal * (1.0 - spreadPct / 2.0) - entryVal
    float pctOfEntry = 100.0 * pnl / entryVal
    curPnlPct := pctOfEntry
    curDays   := int(daysHeld)

    bool doExit = pctOfEntry >= tpPct or pctOfEntry <= -slPct or barsHeld >= holdBars or daysHeld >= dte

    if doExit
        retPct = 100.0 * pnl / capAtRisk
        tradeRet := retPct
        equity := equity * (1.0 + (riskPct / 100.0) * retPct / 100.0)
        peakEq := math.max(peakEq, equity)
        maxDD  := math.max(maxDD, (peakEq - equity) / peakEq * 100.0)
        nTrades += 1
        if retPct > 0
            nWins += 1
            grossWin += retPct
        else
            grossLos += math.abs(retPct)
        inTrade := false
        curPnlPct := 0.0
        curDays := 0

// ----------------------------------------------------------------- PLOTS ---
// Equity curve stays in this pane, on its own scale.
plot(equity, "Equity", color.new(color.teal, 0), 2)
hline(startCap, "Start", color.new(color.gray, 50), hline.style_dashed)

// Entry and exit markers are forced onto the PRICE pane. These mark trades the
// engine actually opened and closed - not raw signal fires. A signal arriving
// while a position is already open is ignored by the engine, and drawing it
// would show entries that never happened.
mSize = markSizeIn == "Tiny" ? size.tiny : markSizeIn == "Small" ? size.small
      : markSizeIn == "Large" ? size.large : size.normal
callTxt = markText == "CALL / PUT" ? "BUY CALL" : markText == "C / P" ? "C" : ""
putTxt  = markText == "CALL / PUT" ? "BUY PUT"  : markText == "C / P" ? "P" : ""

CALL_COL = #00E5A0
PUT_COL  = #FF5C5C

// Two layers, deliberately.
//
// plotshape cannot take dynamic text or size - both must be const strings, and
// ours come from inputs. So the wordy marker is drawn with label.new, which
// does accept series values. Labels are capped (most recent 500 draw), so a
// plain const-text triangle sits underneath as an uncapped base layer: on a
// very long history the old BUY CALL wording drops off but the triangle never
// does. Backtest statistics are unaffected either way - this is drawing only.
plotshape(showMarks and tookLong, "CALL entry", shape.triangleup, location.belowbar,
     color = CALL_COL, size = size.tiny, force_overlay = true)
plotshape(showMarks and tookShort, "PUT entry", shape.triangledown, location.abovebar,
     color = PUT_COL, size = size.tiny, force_overlay = true)

if showMarks and tookLong
    txt = callTxt + (showLabels ? "\n" + str.tostring(markStrike, "#.##") + "  $" + str.tostring(markPrem, "#.##") : "")
    label.new(bar_index, low, text = txt, style = label.style_label_up, size = mSize,
         color = CALL_COL, textcolor = color.black, force_overlay = true)

if showMarks and tookShort
    txt = putTxt + (showLabels ? "\n" + str.tostring(markStrike, "#.##") + "  $" + str.tostring(markPrem, "#.##") : "")
    label.new(bar_index, high, text = txt, style = label.style_label_down, size = mSize,
         color = PUT_COL, textcolor = color.black, force_overlay = true)

plotshape(showMarks and not na(tradeRet) and tradeRet > 0, "Exit win", shape.xcross,
     location.abovebar, color = color.new(CALL_COL, 25), size = size.small, force_overlay = true)
plotshape(showMarks and not na(tradeRet) and tradeRet <= 0, "Exit loss", shape.xcross,
     location.abovebar, color = color.new(PUT_COL, 25), size = size.small, force_overlay = true)

// Shade the holding period in the direction's colour, so an open call position
// reads differently from an open put at a glance.
bgcolor(shadeHold and inTrade ? color.new(posLong ? CALL_COL : PUT_COL, 90) : na, force_overlay = true)

plot(showMA ? trendMA : na, "Trend MA", color.new(color.orange, 20), 2, force_overlay = true)

// Exit labels spell out the result rather than leaving a bare cross to read.
if showExitLb and not na(tradeRet)
    label.new(bar_index, high, force_overlay = true,
         text  = "CLOSE " + (tradeRet > 0 ? "+" : "") + str.tostring(tradeRet, "#.#") + "%",
         style = label.style_label_down, size = size.small,
         color = color.new(tradeRet > 0 ? CALL_COL : PUT_COL, 20),
         textcolor = color.black)

// Entry price line makes the position's basis obvious at a glance.
plot(showEntryLn and inTrade ? entryUnder : na, "Entry price",
     color = color.new(posLong ? CALL_COL : PUT_COL, 30), linewidth = 1,
     style = plot.style_linebr, force_overlay = true)

alertcondition(tookLong,  "CALL entry", "Options engine opened a CALL position")
alertcondition(tookShort, "PUT entry",  "Options engine opened a PUT position")

// Win/loss ticks on the equity pane itself.
plotchar(not na(tradeRet) and tradeRet > 0,  "win",  "▲", location.bottom, color.new(color.teal, 40),   size=size.tiny)
plotchar(not na(tradeRet) and tradeRet <= 0, "loss", "▼", location.top,    color.new(color.maroon, 40), size=size.tiny)

// ------------------------------------------------------------ STATS PANEL ---
// Profit factor and expectancy sit above win rate deliberately. A 70% win rate
// with PF 0.92 is a losing strategy that feels like a winning one, and that
// exact pairing turned up repeatedly in testing.
var table t = table.new(position.top_right, 2, 11, border_width=1, frame_width=1, frame_color=color.gray)

if barstate.islast
    pf = grossLos > 0 ? grossWin / grossLos : na
    wr = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0
    nl = nTrades - nWins
    aw = nWins > 0 ? grossWin / nWins : 0.0
    al = nl > 0 ? grossLos / nl : 0.0
    ex = nTrades > 0 ? (grossWin - grossLos) / nTrades : 0.0

    pfCol = na(pf) ? color.gray : pf >= 1.3 ? color.teal : pf >= 1.0 ? color.orange : color.maroon
    nCol  = nTrades < 30 ? color.maroon : color.gray
    hdr   = isBlind ? color.purple : color.blue

    table.cell(t, 0, 0, isBlind ? "CONTROL - blind" : "Options engine", text_color=color.white, bgcolor=color.new(hdr, 20))
    table.cell(t, 1, 0, isSpread ? "credit" : isStrad ? "straddle" : isStrang ? "strangle" : "long", text_color=color.white, bgcolor=color.new(hdr, 20))
    table.cell(t, 0, 1, "Profit factor")
    table.cell(t, 1, 1, na(pf) ? "n/a" : str.tostring(pf, "#.##"), text_color=pfCol)
    table.cell(t, 0, 2, "Expectancy/trade")
    table.cell(t, 1, 2, str.tostring(ex, "#.#") + "%")
    table.cell(t, 0, 3, "Win rate")
    table.cell(t, 1, 3, str.tostring(wr, "#.#") + "%")
    table.cell(t, 0, 4, "Trades")
    table.cell(t, 1, 4, str.tostring(nTrades), text_color=nCol)
    table.cell(t, 0, 5, "Avg win / loss")
    table.cell(t, 1, 5, str.tostring(aw, "#.#") + "% / " + str.tostring(al, "#.#") + "%")
    table.cell(t, 0, 6, "Max drawdown")
    table.cell(t, 1, 6, str.tostring(maxDD, "#.#") + "%")
    table.cell(t, 0, 7, "Final equity")
    table.cell(t, 1, 7, str.tostring(equity, "#"))
    table.cell(t, 0, 8, "IV now / spread")
    table.cell(t, 1, 8, str.tostring(sigmaNow * 100, "#.#") + "% / " + str.tostring(spreadPct * 100, "#.#") + "%")
    table.cell(t, 0, 9, nTrades < 30 ? "TOO FEW TRADES" : "sample ok")
    table.cell(t, 1, 9, nTrades < 30 ? "not conclusive" : "", text_color=nCol)
    table.cell(t, 0, 10, "Timeframe")
    table.cell(t, 1, 10, isDaily ? "daily (calibrated)" : timeframe.period + " (uncalibrated)",
         text_color = isDaily ? color.gray : color.orange)

// -------------------------------------------------------- LIVE STATUS BANNER ---
// What to do right now, in words. Reads flat or holding, which direction, how
// far into the trade, and what the position is worth.
var table st = table.new(position.bottom_left, 2, 4, border_width=1, frame_width=1, frame_color=color.gray)

if barstate.islast and showStatus
    stateTxt = not inTrade ? "FLAT - no position" : posLong ? "HOLDING CALL" : "HOLDING PUT"
    stateCol = not inTrade ? color.gray : posLong ? CALL_COL : PUT_COL
    daysLeft = holdBars - (bar_index - entryBar)

    table.cell(st, 0, 0, "STATUS", text_color=color.white, bgcolor=color.new(stateCol, 30))
    table.cell(st, 1, 0, stateTxt, text_color=color.white, bgcolor=color.new(stateCol, 30))
    table.cell(st, 0, 1, "Signal")
    table.cell(st, 1, 1, sigName)
    table.cell(st, 0, 2, inTrade ? "Open P&L" : "Last signal")
    table.cell(st, 1, 2, inTrade ? ((curPnlPct > 0 ? "+" : "") + str.tostring(curPnlPct, "#.#") + "%") : "-",
         text_color = not inTrade ? color.gray : curPnlPct > 0 ? CALL_COL : PUT_COL)
    table.cell(st, 0, 3, inTrade ? "Day / exit in" : "Waiting for")
    table.cell(st, 1, 3, inTrade ? (str.tostring(curDays) + "d held / " + str.tostring(daysLeft) + " bars")
         : "next " + (isNeutral ? "volatility" : "entry") + " signal")
