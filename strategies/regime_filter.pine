//@version=6
// ============================================================================
// 50/200 Regime Filter — risk tool, not a signal
// ----------------------------------------------------------------------------
// Runs three equity curves side by side on whatever symbol you load, and
// reports what the filter costs and what it saves.
//
// WHY IT IS BUILT AS A RISK TOOL. Measured across 26 years and 25 large caps,
// the 50/200 relationship carries volatility information, not directional
// information:
//
//   50 above 200   +18.4%/yr   daily vol 1.94%
//   50 below 200   +21.9%/yr   daily vol 2.80%
//
// Returns below the 200 were HIGHER, not lower, and not significantly
// different (t = -0.88). Volatility below it was 1.45x higher. The indicator
// is a smoothed volatility-regime detector, not a forecast of direction.
//
// Which is where its value sits:
//
//   strategy                    CAGR    maxDD   exposure   CAGR/DD
//   Buy & hold                 16.53%   49.3%     100%      0.34
//   Long only while 50 > 200   10.39%   25.7%      65%      0.40
//   Long above / short below    2.84%   40.1%      48%      0.07
//
// Six points of CAGR for half the drawdown. The short leg destroys it.
//
// USE IT ON A PORTFOLIO OR INDEX, NOT A SINGLE TICKER. The basket result
// above does not survive on individual names: running the same filter on 12
// large caps separately, it improved CAGR/DD on only 4 of them.
//
//   AAPL 0.34 -> 0.35   NVDA 0.33 -> 0.41   CSCO 0.05 -> 0.15   INTC 0.05 -> 0.08
//   MSFT 0.22 -> 0.10   IBM  0.10 -> -0.02  WMT  0.25 -> 0.06   KO   0.17 -> 0.07
//
// Two reasons. The filter earns its keep by side-stepping market-wide
// drawdowns that hit every name at once, and a single stock's worst
// drawdowns are usually idiosyncratic - no regime change precedes them. And
// on one ticker the cross whipsaws: 25 to 50 switches per name here, each
// paying the spread. Diversify the thing you are filtering, or the filter has
// nothing to filter.
//
// AND AS AN ENTRY SIGNAL IT IS WORTHLESS. Forward returns after the cross
// itself underperform baseline at every horizon from 20 to 250 bars, and at
// the shorter ones the death cross beat the golden cross. Do not trade the
// cross. Use the STATE to size exposure.
//
// Position is set from the PREVIOUS bar's regime, so no signal is acted on
// before it could have been seen.
// ============================================================================

indicator("50/200 Regime Filter", overlay = false)

grpM = "Moving averages"
fastLen = input.int(50,  "Fast MA", minval=2, group=grpM)
slowLen = input.int(200, "Slow MA", minval=3, group=grpM)
maType  = input.string("SMA", "MA type", options=["SMA","EMA","WMA"], group=grpM)

grpC = "Costs"
switchCost = input.float(0.05, "Cost per regime switch (%)", minval=0, step=0.01, group=grpC,
     tooltip="Charged when exposure changes. The filter trades rarely, so this is small - but it is not zero.")

grpD = "Display"
showBH    = input.bool(true, "Buy & hold curve", group=grpD)
showFilt  = input.bool(true, "Long while 50 > 200", group=grpD)
showLS    = input.bool(false, "Long above / short below", group=grpD,
     tooltip="Off by default: measured at 2.84% CAGR against buy & hold's 16.53%. The short leg is where the money goes.")
showMAs   = input.bool(true, "Plot MAs on price", group=grpD)
shadeReg  = input.bool(true, "Shade bearish regime on price", group=grpD)
logScale  = input.bool(true, "Log-scale the curves", group=grpD)

// --------------------------------------------------------------- REGIME ---
maF = maType == "EMA" ? ta.ema(close, fastLen) : maType == "WMA" ? ta.wma(close, fastLen) : ta.sma(close, fastLen)
maS = maType == "EMA" ? ta.ema(close, slowLen) : maType == "WMA" ? ta.wma(close, slowLen) : ta.sma(close, slowLen)

ready  = not na(maF) and not na(maS) and not na(maF[1]) and not na(maS[1])
// Yesterday's regime decides today's position. No lookahead.
bullish = ready and maF[1] > maS[1]
wFilt   = bullish ? 1.0 : 0.0
wLS     = bullish ? 1.0 : -1.0

ret = na(close[1]) or close[1] == 0 ? 0.0 : (close / close[1] - 1.0) * 100.0

// --------------------------------------------------------------- CURVES ---
var float eqBH   = 1.0
var float eqFilt = 1.0
var float eqLS   = 1.0
var float pkBH   = 1.0
var float pkFilt = 1.0
var float pkLS   = 1.0
var float ddBH   = 0.0
var float ddFilt = 0.0
var float ddLS   = 0.0
var int   nBars  = 0
var float expSum = 0.0
var int   nSwitch = 0

// Volatility by regime — the mechanism the filter actually keys on.
var float sumUp = 0.0
var float sumUp2 = 0.0
var int   nUp = 0
var float sumDn = 0.0
var float sumDn2 = 0.0
var int   nDn = 0

if ready
    switched = wFilt != wFilt[1]
    cost = switched ? switchCost : 0.0
    if switched
        nSwitch += 1

    eqBH   := eqBH   * (1.0 + ret / 100.0)
    eqFilt := eqFilt * (1.0 + (wFilt * ret - cost) / 100.0)
    eqLS   := eqLS   * (1.0 + (wLS   * ret - cost) / 100.0)

    pkBH   := math.max(pkBH, eqBH)
    pkFilt := math.max(pkFilt, eqFilt)
    pkLS   := math.max(pkLS, eqLS)
    ddBH   := math.max(ddBH,   (pkBH - eqBH)     / pkBH   * 100.0)
    ddFilt := math.max(ddFilt, (pkFilt - eqFilt) / pkFilt * 100.0)
    ddLS   := math.max(ddLS,   (pkLS - eqLS)     / pkLS   * 100.0)

    nBars  += 1
    expSum += wFilt

    if bullish
        nUp += 1
        sumUp += ret
        sumUp2 += ret * ret
    else
        nDn += 1
        sumDn += ret
        sumDn2 += ret * ret

// Timeframe-aware annualisation, so CAGR is right off daily charts too.
secPerBar = timeframe.in_seconds()
bpyIntra  = 252.0 * 23400.0 / secPerBar
bpyHigher = timeframe.isdaily ? 252.0 : timeframe.isweekly ? 52.0 : 12.0
barsPerYear = timeframe.isintraday ? bpyIntra : bpyHigher

plot(showBH   ? (logScale ? math.log(eqBH)   : eqBH)   : na, "Buy & hold", color.new(color.gray, 0), 2)
plot(showFilt ? (logScale ? math.log(eqFilt) : eqFilt) : na, "Filtered",   color.new(#00E5A0, 0), 2)
plot(showLS   ? (logScale ? math.log(eqLS)   : eqLS)   : na, "Long/short", color.new(#FF5C5C, 0), 2)
hline(logScale ? 0 : 1, "Start", color.new(color.gray, 60), hline.style_dashed)

plot(showMAs ? maF : na, "Fast MA", color.new(color.orange, 0), 2, force_overlay = true)
plot(showMAs ? maS : na, "Slow MA", color.new(color.blue, 0),   2, force_overlay = true)
bgcolor(shadeReg and ready and not bullish ? color.new(#FF5C5C, 90) : na, force_overlay = true)

alertcondition(ready and bullish and not bullish[1], "Regime turned bullish", "50 crossed above 200 - raise exposure")
alertcondition(ready and not bullish and bullish[1], "Regime turned bearish", "50 crossed below 200 - cut exposure")

// ----------------------------------------------------------------- PANEL ---
var table t = table.new(position.top_right, 5, 8, border_width=1, frame_width=1, frame_color=color.gray)

sdev(sum, sum2, n) =>
    n < 2 ? 0.0 : math.sqrt(math.max(sum2 / n - math.pow(sum / n, 2), 0.0))

if barstate.islast and nBars > barsPerYear
    yrs = nBars / barsPerYear
    cagrBH   = (math.pow(eqBH,   1.0 / yrs) - 1.0) * 100.0
    cagrFilt = (math.pow(math.max(eqFilt, 0.0001), 1.0 / yrs) - 1.0) * 100.0
    cagrLS   = (math.pow(math.max(eqLS,   0.0001), 1.0 / yrs) - 1.0) * 100.0
    expo = 100.0 * expSum / nBars

    volUp = sdev(sumUp, sumUp2, nUp)
    volDn = sdev(sumDn, sumDn2, nDn)

    table.cell(t, 0, 0, "Regime filter", text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 1, 0, "CAGR",     text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 2, 0, "max DD",   text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 3, 0, "CAGR/DD",  text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 4, 0, "growth",   text_color=color.white, bgcolor=color.new(color.blue, 20))

    table.cell(t, 0, 1, "Buy & hold")
    table.cell(t, 1, 1, str.tostring(cagrBH, "#.#") + "%")
    table.cell(t, 2, 1, str.tostring(ddBH, "#.#") + "%")
    table.cell(t, 3, 1, str.tostring(ddBH > 0 ? cagrBH / ddBH : 0, "#.##"))
    table.cell(t, 4, 1, str.tostring(eqBH, "#.#") + "x")

    ratioF = ddFilt > 0 ? cagrFilt / ddFilt : 0.0
    ratioB = ddBH   > 0 ? cagrBH   / ddBH   : 0.0
    fCol = ratioF > ratioB ? #00E5A0 : #FF5C5C
    table.cell(t, 0, 2, "Long while 50>200")
    table.cell(t, 1, 2, str.tostring(cagrFilt, "#.#") + "%")
    table.cell(t, 2, 2, str.tostring(ddFilt, "#.#") + "%")
    table.cell(t, 3, 2, str.tostring(ratioF, "#.##"), text_color=fCol)
    table.cell(t, 4, 2, str.tostring(eqFilt, "#.#") + "x")

    table.cell(t, 0, 3, "Long / short")
    table.cell(t, 1, 3, str.tostring(cagrLS, "#.#") + "%")
    table.cell(t, 2, 3, str.tostring(ddLS, "#.#") + "%")
    table.cell(t, 3, 3, str.tostring(ddLS > 0 ? cagrLS / ddLS : 0, "#.##"))
    table.cell(t, 4, 3, str.tostring(eqLS, "#.#") + "x")

    table.cell(t, 0, 4, "Verdict")
    table.cell(t, 1, 4, ratioF > ratioB ? "filter helps risk-adjusted" : "filter does not help here",
         text_color = fCol)
    table.cell(t, 2, 4, "")
    table.cell(t, 3, 4, "")
    table.cell(t, 4, 4, "")

    table.cell(t, 0, 5, "Vol above / below 200")
    table.cell(t, 1, 5, str.tostring(volUp, "#.##") + "% / " + str.tostring(volDn, "#.##") + "%")
    table.cell(t, 2, 5, volUp > 0 ? str.tostring(volDn / volUp, "#.##") + "x" : "n/a")
    table.cell(t, 3, 5, "")
    table.cell(t, 4, 5, "")

    table.cell(t, 0, 6, "Exposure / switches")
    table.cell(t, 1, 6, str.tostring(expo, "#") + "% / " + str.tostring(nSwitch))
    table.cell(t, 2, 6, "")
    table.cell(t, 3, 6, "")
    table.cell(t, 4, 6, "")

    table.cell(t, 0, 7, "Now")
    table.cell(t, 1, 7, bullish ? "RISK ON - 50 above 200" : "RISK OFF - 50 below 200",
         text_color = bullish ? #00E5A0 : #FF5C5C)
    table.cell(t, 2, 7, "")
    table.cell(t, 3, 7, "")
    table.cell(t, 4, 7, "")
