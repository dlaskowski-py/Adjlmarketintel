//@version=6
// ============================================================================
// Short-Side Signal Meter
// ----------------------------------------------------------------------------
// Death cross, 50MA breaks, and downtrend-continuation setups - and, on the
// same chart, what actually happened after each one.
//
// This measures itself. For every historical signal it records the forward
// N-bar return and compares it to the return after an ordinary bar on the same
// symbol. The panel shows the edge, so you can check any ticker yourself
// instead of trusting a number from somewhere else.
//
// WHAT 26 YEARS OF 25 LARGE CAPS SAID (shorting the underlying, 20-day hold):
//
//   signal                 n      WR      PF    expectancy
//   Death cross          442   43.0%    0.76      -1.00%
//   Price < 50MA        2924   43.3%    0.70      -1.21%
//   Stacked bearish     1869   41.8%    0.65      -1.88%
//   ADX>25 + below 50   1728   40.0%    0.60      -1.95%
//   BLIND short         7762   41.7%    0.65      -1.42%
//
// Note the direction: MORE bearish confirmation produced WORSE results, in
// order. No short signal beat shorting at random.
//
// On the specific claim that a death cross begins a multi-day downtrend:
//   after a death cross   fwd20 +0.97%   48.1% down days   longest down run 3.30
//   after any random day  fwd20 +1.37%   47.9% down days   longest down run 3.44
// Price rose on average, and down runs were SHORTER than baseline.
// 445 crosses across 199 months, so that is not a clustering artifact.
// ============================================================================

indicator("Short-Side Signal Meter", overlay = true, max_labels_count = 500)

// ---------------------------------------------------------------- INPUTS ---
grpS = "Signal"
sigName = input.string("Death cross", "Signal to measure", group=grpS,
     options=["Death cross", "Price below 50MA", "Stacked bearish",
              "ADX + below 50MA", "Golden cross (for contrast)", "Every N bars (control)"])
fastLen = input.int(50,  "Fast MA", minval=2, group=grpS)
slowLen = input.int(200, "Slow MA", minval=3, group=grpS)
adxLen  = input.int(14,  "ADX length", minval=2, group=grpS)
adxMin  = input.float(25.0, "ADX minimum", group=grpS)
ctrlN   = input.int(20,  "Control: bars between entries", minval=2, group=grpS)

grpM = "Measurement"
horizon = input.int(20, "Forward horizon (bars)", minval=1, group=grpM,
     tooltip="How far ahead to measure. The panel compares the return after each signal against the return after an ordinary bar.")
shortSide = input.bool(true, "Measure as a SHORT", group=grpM,
     tooltip="On means a falling price counts as a win. Off measures the same signals long.")

grpV = "Display"
showMAs    = input.bool(true, "Plot moving averages", group=grpV)
showMarks  = input.bool(true, "Mark signals", group=grpV)
showRegime = input.bool(true, "Shade bearish regime", group=grpV)
showPanel  = input.bool(true, "Stats panel", group=grpV)

// ------------------------------------------------------------ INDICATORS ---
maFast = ta.sma(close, fastLen)
maSlow = ta.sma(close, slowLen)
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)

deathX  = ta.crossunder(maFast, maSlow)
goldenX = ta.crossover(maFast, maSlow)
below50 = ta.crossunder(close, maFast)
slopeDn = maFast < maFast[1]
stacked = close < maFast and maFast < maSlow and slopeDn
adxDown = adxV > adxMin and close < maFast and slopeDn

bool fired = false
if sigName == "Death cross"
    fired := deathX
else if sigName == "Price below 50MA"
    fired := below50
else if sigName == "Stacked bearish"
    fired := stacked and not stacked[1]
else if sigName == "ADX + below 50MA"
    fired := adxDown and not adxDown[1]
else if sigName == "Golden cross (for contrast)"
    fired := goldenX
else
    fired := bar_index % ctrlN == 0

// ------------------------------------------------------- SELF-MEASUREMENT ---
// At the current bar, a signal that fired `horizon` bars ago has a known
// outcome. Sign it so a profitable SHORT counts as positive.
sgn = shortSide ? -1.0 : 1.0
matured = not na(close[horizon]) and close[horizon] != 0
outcome = matured ? sgn * (close / close[horizon] - 1.0) * 100.0 : na

var int   nSig = 0
var float sumSig = 0.0
var int   winSig = 0
var float gpSig = 0.0
var float glSig = 0.0

var int   nBase = 0
var float sumBase = 0.0
var int   winBase = 0

// Downtrend character, measured the same way.
var int   nRun = 0
var float sumRun = 0.0
var float sumDownDays = 0.0

if matured
    nBase += 1
    sumBase += outcome
    if outcome > 0
        winBase += 1

    if fired[horizon]
        nSig += 1
        sumSig += outcome
        if outcome > 0
            winSig += 1
            gpSig += outcome
        else
            glSig += math.abs(outcome)

        // longest consecutive down-close run inside the window, and the share
        // of down days - the actual content of "starts a downtrend".
        int best = 0
        int cur = 0
        int dn = 0
        for k = horizon - 1 to 0
            if close[k] < close[k + 1]
                cur += 1
                dn += 1
                best := math.max(best, cur)
            else
                cur := 0
        nRun += 1
        sumRun += best
        sumDownDays += 100.0 * dn / horizon

// ----------------------------------------------------------------- PLOTS ---
plot(showMAs ? maFast : na, "Fast MA", color.new(color.orange, 0), 2)
plot(showMAs ? maSlow : na, "Slow MA", color.new(color.blue, 0), 2)

BEAR = #FF5C5C
BULL = #00E5A0
isGolden = sigName == "Golden cross (for contrast)"
markCol = isGolden ? BULL : BEAR

plotshape(showMarks and fired, "Signal", shape.triangledown, location.abovebar,
     color = BEAR, size = size.small)
bgcolor(showRegime and close < maFast and maFast < maSlow ? color.new(BEAR, 92) : na)

if showMarks and fired
    label.new(bar_index, high, text = isGolden ? "GOLDEN" : "SHORT",
         style = label.style_label_down, size = size.small,
         color = markCol, textcolor = color.black)

alertcondition(fired, "Short signal", "Short-side signal fired")

// ------------------------------------------------------------------ PANEL ---
// Edge is the only line that matters: signal return minus ordinary-bar return
// on THIS symbol. Everything above it is context.
var table t = table.new(position.top_right, 2, 9, border_width=1, frame_width=1, frame_color=color.gray)

if barstate.islast and showPanel
    avgSig  = nSig  > 0 ? sumSig  / nSig  : 0.0
    avgBase = nBase > 0 ? sumBase / nBase : 0.0
    edge    = avgSig - avgBase
    wrSig   = nSig  > 0 ? 100.0 * winSig  / nSig  : 0.0
    wrBase  = nBase > 0 ? 100.0 * winBase / nBase : 0.0
    pfSig   = glSig > 0 ? gpSig / glSig : na
    avgRun  = nRun > 0 ? sumRun / nRun : 0.0
    avgDown = nRun > 0 ? sumDownDays / nRun : 0.0

    edgeCol = edge > 0 ? BULL : BEAR
    nCol    = nSig < 30 ? BEAR : color.gray
    pfCol   = na(pfSig) ? color.gray : pfSig >= 1.3 ? BULL : pfSig >= 1.0 ? color.orange : BEAR

    table.cell(t, 0, 0, shortSide ? "SHORT meter" : "LONG meter", text_color=color.white, bgcolor=color.new(BEAR, 30))
    table.cell(t, 1, 0, str.tostring(horizon) + "-bar", text_color=color.white, bgcolor=color.new(BEAR, 30))
    table.cell(t, 0, 1, "Signal")
    table.cell(t, 1, 1, sigName)
    table.cell(t, 0, 2, "Signals measured")
    table.cell(t, 1, 2, str.tostring(nSig), text_color=nCol)
    table.cell(t, 0, 3, "Avg after signal")
    table.cell(t, 1, 3, str.tostring(avgSig, "#.##") + "%")
    table.cell(t, 0, 4, "Avg after any bar")
    table.cell(t, 1, 4, str.tostring(avgBase, "#.##") + "%")
    table.cell(t, 0, 5, "EDGE")
    table.cell(t, 1, 5, (edge > 0 ? "+" : "") + str.tostring(edge, "#.##") + "pp", text_color=edgeCol)
    table.cell(t, 0, 6, "Win rate vs base")
    table.cell(t, 1, 6, str.tostring(wrSig, "#.#") + "% / " + str.tostring(wrBase, "#.#") + "%")
    table.cell(t, 0, 7, "Profit factor")
    table.cell(t, 1, 7, na(pfSig) ? "n/a" : str.tostring(pfSig, "#.##"), text_color=pfCol)
    table.cell(t, 0, 8, "Down days / run")
    table.cell(t, 1, 8, str.tostring(avgDown, "#") + "% / " + str.tostring(avgRun, "#.#") + " bars")
