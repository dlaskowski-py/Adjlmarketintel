//@version=6
// ============================================================================
// Signal Comparison Lab
// ----------------------------------------------------------------------------
// Every signal tested in the research, plus the blind-entry control, sharing
// ONE exit engine so comparisons are apples-to-apples. Switch "Signal" and
// re-read the Strategy Tester - that is the whole workflow.
//
// THE CONTROL IS THE POINT. "Blind (every N bars)" ignores price entirely and
// enters on a fixed cadence. Any signal worth trading must beat it. Across 26
// years, 12 individual names and two option structures, none of these did -
// blind entry won on both. Run it yourself before trusting any signal here.
//
// MEASURED RESULTS THAT SHAPED THE DEFAULTS:
//   - ADX filter HURTS. It halved the sample and cut profit factor from 1.28
//     to 1.09, so it ships OFF.
//   - The zero-line filter does the real work (PF 1.06 -> 1.28). ON.
//   - Long-only MACD lost money (PF 0.78); the positive expectancy came from
//     short signals clustered in 2008 and 2020.
//
// Pine has no options engine. This backtests the UNDERLYING and measures the
// SIGNAL. Per-contract returns need a real options backtest.
// ============================================================================

strategy("Signal Comparison Lab",
     overlay                 = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.03,
     slippage                = 2,
     calc_on_every_tick      = false,
     process_orders_on_close = true)

// ---------------------------------------------------------------- SIGNAL ---
sigName = input.string("MACD cross + trend", "Signal", group="Signal",
     options=["MACD cross + trend", "RSI(2) mean reversion", "Donchian breakout",
              "EMA cross", "Volatility contraction", "Blind (every N bars)"],
     tooltip="Run each one, then run Blind. If a signal cannot beat Blind on profit factor, it is not adding information.")

grpM = "MACD"
fastLen     = input.int(12, "Fast EMA",   minval=1, group=grpM)
slowLen     = input.int(26, "Slow EMA",   minval=1, group=grpM)
sigLen      = input.int(9,  "Signal EMA", minval=1, group=grpM)
requireZero = input.bool(true, "Require cross on correct side of zero", group=grpM,
     tooltip="Measured to raise profit factor from 1.06 to 1.28. Leave on.")

grpO = "Other signals"
rsiLen   = input.int(2,  "RSI length",          minval=1, group=grpO)
rsiLo    = input.int(10, "RSI oversold",        minval=1, group=grpO)
rsiHi    = input.int(90, "RSI overbought",      minval=1, group=grpO)
donLen   = input.int(55, "Donchian lookback",   minval=2, group=grpO)
emaFast  = input.int(20, "EMA fast",            minval=1, group=grpO)
emaSlow  = input.int(50, "EMA slow",            minval=1, group=grpO)
volPct   = input.int(20, "Vol-contraction percentile", minval=1, maxval=99, group=grpO)
blindN   = input.int(20, "Blind: bars between entries", minval=1, group=grpO)

grpF = "Filters"
useTrend = input.bool(true, "Trend filter (200 MA)", group=grpF)
trendLen = input.int(200, "Trend MA length", minval=1, group=grpF)
useAdx   = input.bool(false, "ADX filter", group=grpF,
     tooltip="OFF by default - measured to REDUCE profit factor from 1.28 to 1.09.")
adxLen   = input.int(14, "ADX length", minval=1, group=grpF)
adxMin   = input.float(20.0, "ADX minimum", minval=0, group=grpF)

grpE = "Exits (shared by every signal)"
atrLen      = input.int(14, "ATR length", minval=1, group=grpE)
stopMult    = input.float(2.0, "Stop (ATR multiple)", minval=0.1, group=grpE)
targetR     = input.float(2.0, "Target (R multiple)", minval=0.1, group=grpE)
maxBars     = input.int(20, "Max bars in trade", minval=1, group=grpE,
     tooltip="Theta punishes stale directional trades. Options need the move to happen fast.")
exitOnFlip  = input.bool(true, "Exit on opposite signal", group=grpE)

grpD = "Direction"
allowLong  = input.bool(true,  "Take long signals",  group=grpD)
allowShort = input.bool(true,  "Take short signals", group=grpD)
blindDir   = input.string("Long only", "Blind direction", options=["Long only","Short only","Alternate"], group=grpD,
     tooltip="Long-only blind on a rising market is pure beta. Run Short-only to see how much of any edge is just drift.")

showStats = input.bool(true, "Show stats panel", group="Display")

// ------------------------------------------------------------ INDICATORS ---
[macdLine, macdSig, macdHist] = ta.macd(close, fastLen, slowLen, sigLen)
trendMA = ta.sma(close, trendLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
atrVal = ta.atr(atrLen)
rsiVal = ta.rsi(close, rsiLen)
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
donHi = ta.highest(high, donLen)[1]
donLo = ta.lowest(low, donLen)[1]

logRet  = math.log(close / close[1])
realVol = ta.stdev(logRet, 20) * math.sqrt(252) * 100
volRank = ta.percentrank(realVol, 252)

// ------------------------------------------------------------- CONDITIONS ---
rawLong  = false
rawShort = false

if sigName == "MACD cross + trend"
    up = ta.crossover(macdLine, macdSig)
    dn = ta.crossunder(macdLine, macdSig)
    rawLong  := up and (not requireZero or macdLine > 0)
    rawShort := dn and (not requireZero or macdLine < 0)

else if sigName == "RSI(2) mean reversion"
    rawLong  := rsiVal < rsiLo
    rawShort := rsiVal > rsiHi

else if sigName == "Donchian breakout"
    rawLong  := close > donHi
    rawShort := close < donLo

else if sigName == "EMA cross"
    rawLong  := ta.crossover(emaF, emaS)
    rawShort := ta.crossunder(emaF, emaS)

else if sigName == "Volatility contraction"
    cheap = not na(volRank) and volRank < volPct
    rawLong  := cheap and close > trendMA
    rawShort := cheap and close <= trendMA

else if sigName == "Blind (every N bars)"
    fire = bar_index % blindN == 0
    isLong = blindDir == "Long only" ? true : blindDir == "Short only" ? false : (math.floor(bar_index / blindN) % 2 == 0)
    rawLong  := fire and isLong
    rawShort := fire and not isLong

// The blind control must stay blind - filters would defeat its purpose.
isBlind = sigName == "Blind (every N bars)"
trendOkL = isBlind or not useTrend or close > trendMA
trendOkS = isBlind or not useTrend or close < trendMA
adxOk    = isBlind or not useAdx or adxVal > adxMin

longSig  = allowLong  and rawLong  and trendOkL and adxOk
shortSig = allowShort and rawShort and trendOkS and adxOk

// ----------------------------------------------------------------- ORDERS ---
// Risk is locked at entry. Recomputing from live ATR each bar lets the stop
// drift, which makes the R multiple - and every win-rate number - meaningless.
var float lockedRisk = na

if longSig and strategy.position_size <= 0
    lockedRisk := atrVal * stopMult
    strategy.entry("Long", strategy.long)

if shortSig and strategy.position_size >= 0
    lockedRisk := atrVal * stopMult
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0 and not na(lockedRisk)
    e = strategy.opentrades.entry_price(strategy.opentrades - 1)
    strategy.exit("L-x", from_entry="Long", stop = e - lockedRisk, limit = e + lockedRisk * targetR)

if strategy.position_size < 0 and not na(lockedRisk)
    e = strategy.opentrades.entry_price(strategy.opentrades - 1)
    strategy.exit("S-x", from_entry="Short", stop = e + lockedRisk, limit = e - lockedRisk * targetR)

entryBar = strategy.opentrades > 0 ? strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : bar_index
if strategy.position_size != 0 and (bar_index - entryBar) >= maxBars
    strategy.close_all(comment = "Time stop")

if exitOnFlip and strategy.position_size > 0 and shortSig
    strategy.close("Long", comment = "Flip")

if exitOnFlip and strategy.position_size < 0 and longSig
    strategy.close("Short", comment = "Flip")

// ------------------------------------------------------------------ PLOTS ---
plot(useTrend and not isBlind ? trendMA : na, "Trend MA", color.new(color.orange, 0), 2)
plotshape(longSig,  "Long",  shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size=size.tiny)
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.new(color.maroon, 0), size=size.tiny)

alertcondition(longSig,  "Long signal",  "Long signal fired")
alertcondition(shortSig, "Short signal", "Short signal fired")

// ------------------------------------------------------------- STATS PANEL ---
// Profit factor and expectancy sit above win rate deliberately. A 70% win rate
// with PF 0.92 is a losing strategy that feels like a winning one - that exact
// combination showed up repeatedly in testing.
var table t = table.new(position.top_right, 2, 9, border_width=1, frame_width=1, frame_color=color.gray)

if barstate.islast and showStats
    closed = strategy.closedtrades
    wins   = strategy.wintrades
    losses = strategy.losstrades
    gp     = strategy.grossprofit
    gl     = strategy.grossloss
    pf     = gl > 0 ? gp / gl : na
    wr     = closed > 0 ? wins / closed * 100 : 0.0
    ex     = closed > 0 ? strategy.netprofit / closed : 0.0
    aw     = wins   > 0 ? gp / wins   : 0.0
    al     = losses > 0 ? gl / losses : 0.0

    pfCol = na(pf) ? color.gray : pf >= 1.3 ? color.teal : pf >= 1.0 ? color.orange : color.maroon
    nCol  = closed < 30 ? color.maroon : color.gray

    table.cell(t, 0, 0, isBlind ? "CONTROL" : "Signal", text_color=color.white, bgcolor=color.new(isBlind ? color.purple : color.blue, 20))
    table.cell(t, 1, 0, isBlind ? "blind"   : "active", text_color=color.white, bgcolor=color.new(isBlind ? color.purple : color.blue, 20))
    table.cell(t, 0, 1, "Profit factor")
    table.cell(t, 1, 1, na(pf) ? "n/a" : str.tostring(pf, "#.##"), text_color=pfCol)
    table.cell(t, 0, 2, "Expectancy/trade")
    table.cell(t, 1, 2, str.tostring(ex, "#.##"))
    table.cell(t, 0, 3, "Win rate")
    table.cell(t, 1, 3, str.tostring(wr, "#.#") + "%")
    table.cell(t, 0, 4, "Trades")
    table.cell(t, 1, 4, str.tostring(closed), text_color=nCol)
    table.cell(t, 0, 5, "Avg win / loss")
    table.cell(t, 1, 5, str.tostring(aw, "#") + " / " + str.tostring(al, "#"))
    table.cell(t, 0, 6, "Max drawdown")
    table.cell(t, 1, 6, str.tostring(strategy.max_drawdown, "#.#"))
    table.cell(t, 0, 7, "Net profit")
    table.cell(t, 1, 7, str.tostring(strategy.netprofit, "#"))
    table.cell(t, 0, 8, closed < 30 ? "TOO FEW TRADES" : "sample ok")
    table.cell(t, 1, 8, closed < 30 ? "not conclusive" : "", text_color=nCol)
