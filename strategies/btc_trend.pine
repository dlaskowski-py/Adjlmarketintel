//@version=6
// ============================================================================
// Crypto Trend Regime — bullish-trend filter for BTC and friends
// ----------------------------------------------------------------------------
// Plots buy-and-hold against the filtered equity curve on the same chart and
// reports what the filter costs and what it saves. It is insurance, not
// prediction: it pays premium during rallies and collects during crashes.
//
// MEASURED ON BTC/USD, 2014-2026 (12.7 years, 10bp per switch):
//
//   strategy            CAGR    maxDD   CAGR/DD   exposure   switches
//   Buy & hold         44.3%    83.3%     0.53      100%          0
//   20/100 MA          49.1%    68.9%     0.71       55%         49
//   30/150 MA          53.9%    67.8%     0.80       57%         25
//   50/200 MA          45.5%    74.3%     0.61       58%         22
//
// Unlike equities, where the same filter costs six points of CAGR, here it
// improves return AND drawdown together. BTC's declines are severe enough
// that avoiding them more than pays for the upside missed.
//
// WHY 30/150 IS THE DEFAULT: it is central in the surface, not its maximum.
// Across a 6x6 grid of fast and slow lengths, ALL 32 valid cells beat
// buy-and-hold - median 0.71, worst 0.57, best 0.95. A whole surface that
// works is a property of the asset; one strong cell would be noise. The
// default is deliberately not the best cell, because that cell is the one
// most likely to be luck.
//
// IT SURVIVED THE OBVIOUS ATTACKS:
//   - cost: still +0.16 over buy-and-hold at 200bp per switch (~2 switches/yr)
//   - single-event dependence: drop the worst crash (2017-12 to 2018-12,
//     -83%) and it still wins, 0.98 against 0.89
//   - cycle by cycle: won all three bear markets, lost two bulls. It turned
//     -25%, -28% and -64% into +6%, +15% and 0%
//
// WHAT IT CANNOT TELL YOU. This is ONE asset with roughly five independent
// cycles. BTC also survived - testing a filter on the crypto that went from
// five cents to eighty thousand dollars says nothing about the ones that went
// to zero, and the buy-and-hold benchmark here is flattered by that survival.
// Treat it as one strong case, not as a law.
// ============================================================================

indicator("Crypto Trend Regime", overlay = false)

grpM = "Trend"
fastLen = input.int(30,  "Fast MA", minval=2, group=grpM)
slowLen = input.int(150, "Slow MA", minval=3, group=grpM)
maType  = input.string("SMA", "MA type", options=["SMA","EMA","WMA"], group=grpM)

grpC = "Costs & calendar"
switchCost = input.float(10.0, "Cost per switch (bps)", minval=0, step=1, group=grpC,
     tooltip="Charged when exposure changes. The filter switches about twice a year, so this bites slowly - it still beat buy-and-hold at 200bp.")
autoCal = input.bool(true, "Auto calendar (365 for crypto, 252 otherwise)", group=grpC)
manualBPY = input.int(365, "Bars per year if manual", minval=1, group=grpC)

grpD = "Display"
showBH   = input.bool(true, "Buy & hold curve", group=grpD)
showFilt = input.bool(true, "Filtered curve", group=grpD)
showMAs  = input.bool(true, "MAs on price", group=grpD)
showSigs = input.bool(true, "BUY / SELL labels on price", group=grpD)
sigSize  = input.string("Normal", "Label size", options=["Small","Normal","Large"], group=grpD)
showPnL  = input.bool(true, "Show each trade's result on the SELL label", group=grpD)
showEntry= input.bool(true, "Entry price line while holding", group=grpD)
shadeOff = input.bool(true, "Shade risk-off on price", group=grpD)
logScale = input.bool(true, "Log-scale curves", group=grpD)

// --------------------------------------------------------------- REGIME ---
maF = maType == "EMA" ? ta.ema(close, fastLen) : maType == "WMA" ? ta.wma(close, fastLen) : ta.sma(close, fastLen)
maS = maType == "EMA" ? ta.ema(close, slowLen) : maType == "WMA" ? ta.wma(close, slowLen) : ta.sma(close, slowLen)

ready = not na(maF[1]) and not na(maS[1])
// Yesterday's regime sets today's exposure, so nothing is acted on early.
riskOn = ready and maF[1] > maS[1]
w = riskOn ? 1.0 : 0.0
ret = na(close[1]) or close[1] == 0 ? 0.0 : (close / close[1] - 1.0) * 100.0

// Crypto never closes, so a year is 365 bars rather than 252. Getting this
// wrong misstates CAGR by about 45%.
isCrypto = syminfo.type == "crypto"
dailyBPY = isCrypto ? 365.0 : 252.0
secPerBar = timeframe.in_seconds()
intraBPY = dailyBPY * (isCrypto ? 86400.0 : 23400.0) / secPerBar
autoBPY = timeframe.isintraday ? intraBPY : timeframe.isdaily ? dailyBPY : timeframe.isweekly ? 52.0 : 12.0
barsPerYear = autoCal ? autoBPY : manualBPY

// --------------------------------------------------------------- CURVES ---
var float eqBH = 1.0
var float eqF  = 1.0
var float pkBH = 1.0
var float pkF  = 1.0
var float ddBH = 0.0
var float ddF  = 0.0
var int   nBar = 0
var float expo = 0.0
var int   nSw  = 0
var int   barsOn = 0

// Trade bookkeeping. A "trade" is one risk-on stretch, entered on the bar the
// regime turns bullish and closed when it turns bearish.
var float entryPx   = na
var int   entryBar  = 0
var int   nTrades   = 0
var int   nWins     = 0
var float sumWin    = 0.0
var float sumLoss   = 0.0
var float bestTrade = 0.0
var float worstTrade= 0.0
var float lastTrade = na

if ready
    switched = w != w[1]
    k = switched ? switchCost / 100.0 : 0.0
    if switched
        nSw += 1
    eqBH := eqBH * (1.0 + ret / 100.0)
    eqF  := eqF  * (1.0 + (w * ret - k) / 100.0)
    pkBH := math.max(pkBH, eqBH)
    pkF  := math.max(pkF, eqF)
    ddBH := math.max(ddBH, (pkBH - eqBH) / pkBH * 100.0)
    ddF  := math.max(ddF,  (pkF - eqF)   / pkF  * 100.0)
    nBar += 1
    expo += w
    if riskOn
        barsOn += 1

    if riskOn and not riskOn[1]
        entryPx := close
        entryBar := bar_index

    if not riskOn and riskOn[1] and not na(entryPx) and entryPx > 0
        tr = (close / entryPx - 1.0) * 100.0
        lastTrade := tr
        nTrades += 1
        if tr > 0
            nWins += 1
            sumWin += tr
        else
            sumLoss += math.abs(tr)
        bestTrade := math.max(bestTrade, tr)
        worstTrade := math.min(worstTrade, tr)

GREEN = #00E5A0
RED   = #FF5C5C

plot(showBH   ? (logScale ? math.log(eqBH) : eqBH) : na, "Buy & hold", color.new(color.gray, 0), 2)
plot(showFilt ? (logScale ? math.log(eqF)  : eqF)  : na, "Filtered",   color.new(GREEN, 0), 2)
hline(logScale ? 0 : 1, "Start", color.new(color.gray, 60), hline.style_dashed)

plot(showMAs ? maF : na, "Fast MA", color.new(color.orange, 0), 2, force_overlay = true)
plot(showMAs ? maS : na, "Slow MA", color.new(color.blue, 0),   2, force_overlay = true)
bgcolor(shadeOff and ready and not riskOn ? color.new(RED, 88) : na, force_overlay = true)

// Two layers. plotshape cannot take dynamic text, so the wordy label is drawn
// with label.new (which accepts series values) and an uncapped const triangle
// sits underneath - on a long history the labels age out at 500, the triangles
// never do.
buySig  = ready and riskOn and not riskOn[1]
sellSig = ready and not riskOn and riskOn[1]

plotshape(showSigs and buySig,  "Buy marker",  shape.triangleup,   location.belowbar,
     color = GREEN, size = size.tiny, force_overlay = true)
plotshape(showSigs and sellSig, "Sell marker", shape.triangledown, location.abovebar,
     color = RED,   size = size.tiny, force_overlay = true)

lblSize = sigSize == "Small" ? size.small : sigSize == "Large" ? size.large : size.normal

if showSigs and buySig
    label.new(bar_index, low, text = "BUY", style = label.style_label_up, size = lblSize,
         color = GREEN, textcolor = color.black, force_overlay = true)

if showSigs and sellSig
    res = na(lastTrade) ? "" : "\n" + (lastTrade > 0 ? "+" : "") + str.tostring(lastTrade, "#.#") + "%"
    label.new(bar_index, high, text = "SELL" + (showPnL ? res : ""),
         style = label.style_label_down, size = lblSize,
         color = na(lastTrade) or lastTrade > 0 ? GREEN : RED,
         textcolor = color.black, force_overlay = true)

// Basis line while a position is open.
plot(showEntry and riskOn and not na(entryPx) ? entryPx : na, "Entry price",
     color = color.new(GREEN, 30), linewidth = 1, style = plot.style_linebr, force_overlay = true)

alertcondition(ready and riskOn and not riskOn[1],  "Trend turned bullish", "Fast MA crossed above slow - risk on")
alertcondition(ready and not riskOn and riskOn[1],  "Trend turned bearish", "Fast MA crossed below slow - risk off")

// ----------------------------------------------------------------- PANEL ---
var table t = table.new(position.top_right, 5, 8, border_width=1, frame_width=1, frame_color=color.gray)

if barstate.islast and nBar > barsPerYear
    yrs = nBar / barsPerYear
    cagrBH = (math.pow(math.max(eqBH, 0.0001), 1.0 / yrs) - 1.0) * 100.0
    cagrF  = (math.pow(math.max(eqF,  0.0001), 1.0 / yrs) - 1.0) * 100.0
    rBH = ddBH > 0 ? cagrBH / ddBH : 0.0
    rF  = ddF  > 0 ? cagrF  / ddF  : 0.0
    good = rF > rBH

    table.cell(t, 0, 0, "Trend regime", text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 1, 0, "CAGR",    text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 2, 0, "max DD",  text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 3, 0, "CAGR/DD", text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 4, 0, "growth",  text_color=color.white, bgcolor=color.new(color.blue, 20))

    table.cell(t, 0, 1, "Buy & hold")
    table.cell(t, 1, 1, str.tostring(cagrBH, "#.#") + "%")
    table.cell(t, 2, 1, str.tostring(ddBH, "#.#") + "%")
    table.cell(t, 3, 1, str.tostring(rBH, "#.##"))
    table.cell(t, 4, 1, str.tostring(eqBH, "#.#") + "x")

    table.cell(t, 0, 2, str.tostring(fastLen) + "/" + str.tostring(slowLen) + " filter")
    table.cell(t, 1, 2, str.tostring(cagrF, "#.#") + "%")
    table.cell(t, 2, 2, str.tostring(ddF, "#.#") + "%")
    table.cell(t, 3, 2, str.tostring(rF, "#.##"), text_color = good ? GREEN : RED)
    table.cell(t, 4, 2, str.tostring(eqF, "#.#") + "x")

    table.cell(t, 0, 3, "Verdict")
    table.cell(t, 1, 3, good ? "filter earns its keep here" : "filter does not help here",
         text_color = good ? GREEN : RED)
    table.cell(t, 2, 3, "")
    table.cell(t, 3, 3, "")
    table.cell(t, 4, 3, "")

    table.cell(t, 0, 4, "Drawdown saved")
    table.cell(t, 1, 4, str.tostring(ddBH - ddF, "#.#") + "pp")
    table.cell(t, 2, 4, "CAGR given up")
    table.cell(t, 3, 4, str.tostring(cagrBH - cagrF, "#.#") + "pp")
    table.cell(t, 4, 4, "")

    table.cell(t, 0, 5, "Exposure / switches")
    table.cell(t, 1, 5, str.tostring(100.0 * expo / nBar, "#") + "% / " + str.tostring(nSw))
    table.cell(t, 2, 5, "per year")
    table.cell(t, 3, 5, str.tostring(nSw / yrs, "#.#"))
    table.cell(t, 4, 5, "")

    table.cell(t, 0, 6, "Calendar")
    table.cell(t, 1, 6, str.tostring(barsPerYear, "#") + " bars/yr" + (isCrypto ? " (crypto)" : ""))
    table.cell(t, 2, 6, "years")
    table.cell(t, 3, 6, str.tostring(yrs, "#.#"))
    table.cell(t, 4, 6, "")

    table.cell(t, 0, 7, "Now")
    table.cell(t, 1, 7, riskOn ? "RISK ON - hold" : "RISK OFF - flat",
         text_color = riskOn ? GREEN : RED)
    table.cell(t, 2, 7, "")
    table.cell(t, 3, 7, "")
    table.cell(t, 4, 7, "")

// --------------------------------------------------------- POSITION BANNER ---
// Where you stand right now, and how the individual trades have gone.
var table pos = table.new(position.bottom_left, 2, 6, border_width=1, frame_width=1, frame_color=color.gray)

if barstate.islast and showSigs
    openPnL = riskOn and not na(entryPx) and entryPx > 0 ? (close / entryPx - 1.0) * 100.0 : na
    held = riskOn ? bar_index - entryBar : 0
    wr = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0
    avgW = nWins > 0 ? sumWin / nWins : 0.0
    nL = nTrades - nWins
    avgL = nL > 0 ? sumLoss / nL : 0.0
    stateCol = riskOn ? GREEN : RED

    table.cell(pos, 0, 0, "POSITION", text_color=color.white, bgcolor=color.new(stateCol, 30))
    table.cell(pos, 1, 0, riskOn ? "LONG - holding" : "FLAT - waiting for BUY",
         text_color=color.white, bgcolor=color.new(stateCol, 30))
    table.cell(pos, 0, 1, riskOn ? "Entry price" : "Last trade")
    table.cell(pos, 1, 1, riskOn ? str.tostring(entryPx, format.mintick)
         : (na(lastTrade) ? "-" : (lastTrade > 0 ? "+" : "") + str.tostring(lastTrade, "#.#") + "%"),
         text_color = riskOn ? color.gray : (na(lastTrade) or lastTrade > 0 ? GREEN : RED))
    table.cell(pos, 0, 2, riskOn ? "Open P&L" : "Next signal")
    table.cell(pos, 1, 2, riskOn ? ((openPnL > 0 ? "+" : "") + str.tostring(openPnL, "#.#") + "%") : "BUY on bullish cross",
         text_color = riskOn ? (openPnL > 0 ? GREEN : RED) : color.gray)
    table.cell(pos, 0, 3, riskOn ? "Bars held" : "Bars flat")
    table.cell(pos, 1, 3, str.tostring(riskOn ? held : bar_index - entryBar))
    table.cell(pos, 0, 4, "Completed trades")
    table.cell(pos, 1, 4, str.tostring(nTrades) + "  win rate " + str.tostring(wr, "#") + "%")
    table.cell(pos, 0, 5, "Avg win / loss")
    table.cell(pos, 1, 5, "+" + str.tostring(avgW, "#.#") + "% / -" + str.tostring(avgL, "#.#") + "%")
