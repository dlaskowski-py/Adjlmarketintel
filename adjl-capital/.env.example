# ── ADJL Capital — Market Intelligence ──────────────────────
# Copy this file to `.env.local` (and `.env` for the Prisma CLI) and fill
# in the values before running the app.

# Anthropic API key — https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Change to your production URL when deploying on Vercel
NEXTAUTH_URL=http://localhost:3000
# NextAuth v5 also reads AUTH_SECRET / AUTH_URL — keep them in sync
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Supabase Postgres connection string — project settings → database
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Realty Mole (RapidAPI) — https://realtymole.com after signup
REALTY_MOLE_API_KEY=

# Optional: seed passwords for the three partner accounts
SEED_PW_DANIEL=CHANGE_ME_1
SEED_PW_ANDREW=CHANGE_ME_2
SEED_PW_JAMES=CHANGE_ME_3
